# Generate one P-256 VAPID key pair and keep the private key server-only.
# The public key is safe to expose to the browser and must match the private key.
VAPID_SUBJECT="mailto:notifications@campusdelight.net"
VAPID_PRIVATE_KEY="<base64url-p256-private-key>"
VAPID_PUBLIC_KEY="<base64url-p256-public-key>"
VITE_VAPID_PUBLIC_KEY="<same-base64url-p256-public-key>"

# Telegram bot configuration. Keep the token and webhook secret server-only.
TELEGRAM_BOT_TOKEN="<bot-token-from-botfather>"
TELEGRAM_BOT_USERNAME="<bot-username-without-@>"
TELEGRAM_WEBHOOK_SECRET="<long-random-webhook-secret>"
